#!/usr/bin/env bash
set -euo pipefail

changed=$(git status --porcelain)

if [ -z "$changed" ]; then
  echo "bin/publish: nothing to publish" >&2
  exit 1
fi

outside=$(printf '%s\n' "$changed" | cut -c4- | grep -Ev '^(_posts|_drafts)/' || true)

if [ -n "$outside" ]; then
  echo "bin/publish: refusing, unrelated changes outside _posts/ and _drafts/:" >&2
  printf '%s\n' "$outside" >&2
  exit 1
fi

files=$(printf '%s\n' "$changed" | cut -c4- | grep -E '^_posts/' || true)

if [ -z "$files" ]; then
  echo "bin/publish: only _drafts/ changes found; drafts are not part of the published site" >&2
  exit 1
fi

git add -- _posts

count=$(printf '%s\n' "$files" | wc -l | tr -d ' ')
if [ "$count" -eq 1 ]; then
  slug=$(basename "$files" .md | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//')
  message="Post: $slug"
else
  message="Post: $count posts"
fi

git commit -m "$message"
git push origin master
